# 可予礼品竞品监控平台 - 环境变量配置
# 复制此文件为 .env 并修改

# ==========================================
# 服务器配置
# ==========================================
CANDY_HOST=0.0.0.0
CANDY_PORT=5000
CANDY_THREADS=4
CANDY_DEBUG=false

# ==========================================
# 文案模型 API Key（至少配置一个即可使用）
# ==========================================

# DeepSeek V3 — 注册 platform.deepseek.com 送 500 万 token（推荐首选）
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 豆包 Pro — 注册 console.volcengine.com 开通豆包，有免费额度
DOUBAO_API_KEY=xxxxxxxx

# 通义千问 Qwen3 — 注册 dashscope.aliyun.com 有免费额度
QWEN_API_KEY=sk-xxxxxxxx

# Kimi — 注册 platform.moonshot.cn 送额度
KIMI_API_KEY=sk-xxxxxxxx

# Gemini 2.0 Flash — 在 aistudio.google.com 获取 Key，免费 1500 次/天
GEMINI_API_KEY=AIzaxxxxxxxx

# GPT-4o-mini — 注册 platform.openai.com 送 5 美元（需绑卡）
OPENAI_API_KEY=sk-xxxxxxxx

# ==========================================
# 图片模型 API Key
# ==========================================

# Cloudflare Workers AI — 注册 Cloudflare，Workers AI 每天免费 300 次
CLOUDFLARE_API_KEY=xxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxx

# HuggingFace — 注册 huggingface.co → Settings → Access Tokens（用于 SDXL / Janus / 视频模型）
HF_API_KEY=hf_xxxxxxxx

# ==========================================
# 默认模型选择
# ==========================================
DEFAULT_TEXT_MODEL=deepseek
DEFAULT_IMAGE_MODEL=flux_schnell
DEFAULT_VIDEO_MODEL=cogvideo
